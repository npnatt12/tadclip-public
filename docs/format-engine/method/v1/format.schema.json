{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadclip.local/format-engine/format.schema.json",
  "title": "TadClip saved creator format",
  "description": "One editing format read from a cluster of a creator's reels (METHOD.md, part 2). Every numeric field is a measured range with its spec source and the reel.json lever it sets. Positions are % of the frame (y from the top), times in seconds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_id", "creator", "version", "language", "summary", "reels", "length", "rhythm", "text", "layout", "audio", "devices", "structure", "unknown"],
  "properties": {
    "format_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "creator": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "language": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["th", "en"] } },
    "summary": { "type": "string", "description": "The one-paragraph reading of the format." },
    "reels": {
      "description": "Every reel considered, members and excluded ones (METHOD R1).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "member", "reason"],
        "properties": {
          "id": { "type": "string" },
          "seconds": { "type": "number", "minimum": 0 },
          "w": { "type": "integer" },
          "h": { "type": "integer" },
          "member": { "type": "boolean" },
          "reason": { "type": "string", "description": "Which shared devices put it in the cluster, or why it is excluded." }
        }
      }
    },
    "length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds"],
      "properties": { "seconds": { "$ref": "#/$defs/range" } }
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_min", "shot_median", "shot_p90", "first", "cut_kinds"],
      "properties": {
        "per_min": { "$ref": "#/$defs/range" },
        "shot_median": { "$ref": "#/$defs/range" },
        "shot_p90": { "$ref": "#/$defs/range" },
        "first": { "$ref": "#/$defs/range" },
        "cut_kinds": {
          "description": "Shares of cut detections by kind, read on the contact sheet (METHOD R2). Should sum to about 1.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speaker": { "$ref": "#/$defs/range" },
            "layout": { "$ref": "#/$defs/range" },
            "inset": { "$ref": "#/$defs/range" }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_seen", "seconds_median", "gap_median", "line_h_median", "own_share_of_time", "roles"],
      "properties": {
        "first_seen": { "$ref": "#/$defs/range" },
        "seconds_median": { "$ref": "#/$defs/range" },
        "gap_median": { "$ref": "#/$defs/range" },
        "rows_median": { "$ref": "#/$defs/range" },
        "line_h_median": { "$ref": "#/$defs/range" },
        "own_share_of_time": { "$ref": "#/$defs/range" },
        "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["face_share", "face_top", "face_bottom", "face_height", "face_cx", "shares"],
      "properties": {
        "face_share": { "$ref": "#/$defs/range" },
        "face_top": { "$ref": "#/$defs/range" },
        "face_bottom": { "$ref": "#/$defs/range" },
        "face_height": { "$ref": "#/$defs/range" },
        "face_cx": { "$ref": "#/$defs/range" },
        "shares": {
          "description": "Share of reel time per layout, from the contact sheet weighted by shot length (METHOD R5).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "full_speaker": { "$ref": "#/$defs/range" },
            "split": { "$ref": "#/$defs/range" },
            "panel": { "$ref": "#/$defs/range" },
            "inset": { "$ref": "#/$defs/range" },
            "full_cutaway": { "$ref": "#/$defs/range" }
          }
        },
        "block_seconds": { "$ref": "#/$defs/range" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pauses_per_min", "longest_pause"],
      "properties": {
        "pauses_per_min": { "$ref": "#/$defs/range" },
        "longest_pause": { "$ref": "#/$defs/range" },
        "lufs_note": { "type": "string", "description": "Why audio.lufs is not saved (METHOD R6)." }
      }
    },
    "devices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/device" } },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "body", "end"],
      "properties": {
        "hook": { "$ref": "#/$defs/phase" },
        "body": { "$ref": "#/$defs/phase" },
        "end": { "$ref": "#/$defs/phase" }
      }
    },
    "unknown": {
      "description": "What neither the spec nor the contact sheet can show; TadClip defaults apply until someone watches a reel.",
      "type": "array",
      "items": { "type": "string" }
    },
    "fit_notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "basis": { "enum": ["measured", "looked", "derived"] },
    "span": {
      "description": "A range inside a role or device; the lever is the parent's.",
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "accept", "n", "basis", "source"],
      "properties": {
        "observed": { "$ref": "#/$defs/pair" },
        "accept": { "$ref": "#/$defs/pair" },
        "unit": { "type": "string" },
        "n": { "type": "integer", "minimum": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "range": {
      "description": "observed = [min, max] over member reels; accept = observed widened by max(15 %, the measurement floor) (METHOD S1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "accept", "n", "basis", "source", "lever"],
      "properties": {
        "observed": { "$ref": "#/$defs/pair" },
        "accept": { "$ref": "#/$defs/pair" },
        "unit": { "type": "string" },
        "n": { "type": "integer", "minimum": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "source": { "type": "string", "description": "Spec path (e.g. cuts.per_min, text.list[role].y) or 'contact sheet'." },
        "lever": { "type": "string", "description": "The reel.json path it sets, or 'none: <why>'." },
        "confidence": { "enum": ["normal", "low"] },
        "note": { "type": "string" }
      }
    },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "role": {
      "description": "A kind of the creator's own on-screen text (METHOD R3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "y", "basis", "style", "when", "lever"],
      "anyOf": [{ "required": ["seconds"] }, { "required": ["share"] }],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["caption", "punch", "title", "label", "bar", "cta", "cutaway-text"] },
        "y": { "$ref": "#/$defs/span" },
        "x": { "$ref": "#/$defs/span" },
        "line_h": { "$ref": "#/$defs/span" },
        "rows": { "$ref": "#/$defs/span" },
        "seconds": { "$ref": "#/$defs/span" },
        "share": { "$ref": "#/$defs/span" },
        "plate": { "type": "array", "items": { "$ref": "#/$defs/hex" }, "description": "Measured plate colours; empty = over the footage." },
        "letters": { "type": "array", "items": { "$ref": "#/$defs/hex" } },
        "basis": { "$ref": "#/$defs/basis" },
        "style": { "type": "string", "description": "What the contact sheet shows: weight, italic, case, outline, plate shape, which word takes the accent." },
        "when": { "type": "string" },
        "lever": { "$ref": "#/$defs/lever" }
      }
    },
    "lever": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "Beat type or reel.json path, e.g. 'beats[type=verdict]' or 'captions'." },
        "fields": { "type": "object", "description": "Suggested lever values (px on 1080x1920)." },
        "gap": { "type": "string", "description": "What the builder cannot express yet, if anything." }
      }
    },
    "device": {
      "description": "A recurring treatment with a job (METHOD S3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "what", "when", "seen_in", "role", "basis", "lever", "needs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "what": { "type": "string" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor", "cue"],
          "properties": {
            "anchor": { "enum": ["hook", "spoken-cue", "section-change", "persistent", "end"] },
            "from": { "enum": ["start", "end"], "description": "What t is measured from." },
            "t": { "$ref": "#/$defs/span" },
            "duration": { "$ref": "#/$defs/span" },
            "cue": { "type": "string", "description": "What in the speech or the edit triggers it." }
          }
        },
        "where": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "y": { "$ref": "#/$defs/span" },
            "x": { "$ref": "#/$defs/span" },
            "text_role": { "type": "string", "description": "id of a text.roles entry this device uses." }
          }
        },
        "seen_in": {
          "type": "object",
          "additionalProperties": false,
          "required": ["k", "n", "evidence"],
          "properties": {
            "k": { "type": "integer", "minimum": 1 },
            "n": { "type": "integer", "minimum": 1 },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reel", "t"],
                "properties": { "reel": { "type": "string" }, "t": { "type": "number" }, "note": { "type": "string" } }
              }
            }
          }
        },
        "role": { "enum": ["signature", "optional"] },
        "basis": { "$ref": "#/$defs/basis" },
        "lever": { "$ref": "#/$defs/lever" },
        "needs": { "type": "array", "items": { "type": "string" }, "description": "Material the new clip must have for this device (METHOD F1)." }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "devices"],
      "properties": {
        "seconds": { "$ref": "#/$defs/span" },
        "what": { "type": "string" },
        "devices": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
