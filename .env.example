# TadClip keys. Paste each key right after the = sign, with no spaces or quotes, then save.
# Where to get them, click by click: docs/INSTALL.md, step 3.

# All optional. TadClip edits without them; each one makes the reels more tailored.

# Optional (free): a more exact Thai transcript, B-roll that matches its line, pictures scored for you
GEMINI_API_KEY=

# Optional (free): more stock choice; without it, stock comes from Mixkit and Wikimedia
PEXELS_API_KEY=

# Optional: only the vector explainer's narrator
ELEVENLABS_API_KEY=
